generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PricingRuleKind {
  PLATFORM_FEE
  PAYMENT_FEE
  SELLER_FEE
  SHIPPING_MARGIN

  @@map("pricing_rule_kind")
}

enum LedgerTransactionType {
  ORDER_PAYMENT
  PROMOTION_PURCHASE
  SUBSCRIPTION_PURCHASE
  ADVERTISING_PURCHASE
  PAYOUT
  REFUND
  REVERSAL
  SHIPPING_SETTLEMENT

  @@map("ledger_transaction_type")
}

enum WalletEntryStatus {
  PENDING
  AVAILABLE
  WITHDRAWN
  HELD
  REFUNDED

  @@map("wallet_entry_status")
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED

  @@map("payout_status")
}

enum RefundType {
  FULL_REFUND
  PARTIAL_REFUND

  @@map("refund_type")
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED

  @@map("refund_status")
}

model PricingRule {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String            @unique
  kind      PricingRuleKind
  currency  String            @default("VND") @db.Char(3)
  status    String
  createdAt DateTime          @default(now()) @map("created_at")
  versions  PricingVersion[]

  @@map("pricing_rules")
}

model PricingVersion {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId        String      @map("rule_id") @db.Uuid
  rateBps       Int         @map("rate_bps")
  fixedAmount   BigInt      @default(0) @map("fixed_amount")
  effectiveFrom DateTime    @map("effective_from")
  effectiveTo   DateTime?   @map("effective_to")
  createdBy     String?     @map("created_by") @db.Uuid
  reason        String
  createdAt     DateTime    @default(now()) @map("created_at")
  rule          PricingRule @relation(fields: [ruleId], references: [id])

  @@map("pricing_versions")
}

model PromotionPackage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String   @unique
  name          String
  price         BigInt
  durationHours Int      @map("duration_hours")
  promotionType String   @map("promotion_type")
  status        String   @default("ACTIVE")
  effectiveFrom DateTime @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime @default(now()) @map("created_at")
  @@map("promotion_packages")
}

model PromotionPackageVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId     String   @map("package_id") @db.Uuid
  price         BigInt
  durationHours Int      @map("duration_hours")
  promotionType String   @map("promotion_type")
  status        String   @default("ACTIVE")
  effectiveFrom DateTime @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdBy     String?  @map("created_by") @db.Uuid
  reason        String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([packageId, status, effectiveFrom])
  @@map("promotion_package_versions")
}

model PromotionOrder {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId             String   @map("seller_id") @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  packageId            String   @map("package_id") @db.Uuid
  packageVersionId     String   @map("package_version_id") @db.Uuid
  packagePriceSnapshot BigInt   @map("package_price_snapshot")
  durationHoursSnapshot Int     @map("duration_hours_snapshot")
  promotionTypeSnapshot String  @map("promotion_type_snapshot")
  status               String   @default("PENDING")
  idempotencyKey       String?  @unique @map("idempotency_key")
  paidAt               DateTime? @map("paid_at")
  createdAt            DateTime @default(now()) @map("created_at")
  @@index([sellerId, createdAt])
  @@map("promotion_orders")
}

model SubscriptionPlan {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String   @unique
  name          String
  price         BigInt
  billingCycle  String   @map("billing_cycle")
  maxListings   Int?     @map("max_listings")
  features      Json     @default("[]")
  status        String   @default("ACTIVE")
  effectiveFrom DateTime @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime @default(now()) @map("created_at")
  @@map("subscription_plans")
}

model SubscriptionPlanVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId        String   @map("plan_id") @db.Uuid
  price         BigInt
  billingCycle  String   @map("billing_cycle")
  maxListings   Int?     @map("max_listings")
  features      Json     @default("[]")
  status        String   @default("ACTIVE")
  effectiveFrom DateTime @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdBy     String?  @map("created_by") @db.Uuid
  reason        String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([planId, status, effectiveFrom])
  @@map("subscription_plan_versions")
}

model Subscription {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String   @map("seller_id") @db.Uuid
  planId        String   @map("plan_id") @db.Uuid
  planVersionId String   @map("plan_version_id") @db.Uuid
  priceSnapshot BigInt   @map("price_snapshot")
  billingCycleSnapshot String @map("billing_cycle_snapshot")
  maxListingsSnapshot Int? @map("max_listings_snapshot")
  featuresSnapshot Json @default("[]") @map("features_snapshot")
  status        String   @default("ACTIVE")
  startsAt      DateTime @map("starts_at")
  endsAt        DateTime? @map("ends_at")
  createdAt     DateTime @default(now()) @map("created_at")
  @@index([sellerId, status, endsAt])
  @@map("subscriptions")
}

model SubscriptionOrder {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId            String   @map("seller_id") @db.Uuid
  planId              String   @map("plan_id") @db.Uuid
  planVersionId       String   @map("plan_version_id") @db.Uuid
  priceSnapshot       BigInt   @map("price_snapshot")
  billingCycleSnapshot String  @map("billing_cycle_snapshot")
  maxListingsSnapshot Int?     @map("max_listings_snapshot")
  featuresSnapshot    Json     @default("[]") @map("features_snapshot")
  status              String   @default("PENDING")
  idempotencyKey      String   @unique @map("idempotency_key")
  ledgerTransactionId String?  @map("ledger_transaction_id") @db.Uuid
  subscriptionId      String?  @map("subscription_id") @db.Uuid
  paidAt              DateTime? @map("paid_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @map("updated_at")
  @@index([sellerId, status, createdAt])
  @@map("subscription_orders")
}

model AdvertisingCampaign {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId            String   @map("seller_id") @db.Uuid
  productId           String?  @map("product_id") @db.Uuid
  campaignType        String   @map("campaign_type")
  pricingModel        String   @default("FIXED_PRICE") @map("pricing_model")
  budget              BigInt
  spent               BigInt   @default(0)
  status              String   @default("DRAFT")
  startAt             DateTime? @map("start_at")
  endAt               DateTime? @map("end_at")
  ledgerTransactionId String?  @map("ledger_transaction_id") @db.Uuid
  paidAt              DateTime? @map("paid_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @map("updated_at")
  @@index([sellerId, status])
  @@map("advertising_campaigns")
}

model ShippingTransaction {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId             String   @unique @map("order_id") @db.Uuid
  customerFee         BigInt   @map("customer_fee")
  providerCost        BigInt   @map("provider_cost")
  platformMargin      BigInt   @map("platform_margin")
  status              String   @default("PENDING")
  ledgerTransactionId String?  @map("ledger_transaction_id") @db.Uuid
  settledBy           String?  @map("settled_by") @db.Uuid
  settledAt           DateTime? @map("settled_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @map("updated_at")
  @@index([status, createdAt])
  @@map("shipping_transactions")
}

model LedgerTransaction {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           LedgerTransactionType
  orderId        String?               @map("order_id") @db.Uuid
  paymentId      String?               @map("payment_id") @db.Uuid
  referenceId    String?               @map("reference_id") @db.Uuid
  idempotencyKey String?               @unique @map("idempotency_key")
  status         String
  createdAt      DateTime              @default(now()) @map("created_at")
  finalizedAt    DateTime?             @map("finalized_at")
  entries        LedgerEntry[]

  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  accountCode   String            @map("account_code")
  amount        BigInt
  currency      String            @default("VND") @db.Char(3)
  userId        String?           @map("user_id") @db.Uuid
  orderId       String?           @map("order_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@index([orderId])
  @@map("ledger_entries")
}

model SellerWallet {
  sellerId         String   @id @map("seller_id") @db.Uuid
  pendingBalance   BigInt   @default(0) @map("pending_balance")
  availableBalance BigInt   @default(0) @map("available_balance")
  heldBalance      BigInt   @default(0) @map("held_balance")
  updatedAt        DateTime @default(now()) @map("updated_at")

  @@map("seller_wallets")
}

model WalletTransaction {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId            String            @map("seller_id") @db.Uuid
  orderId             String?           @map("order_id") @db.Uuid
  ledgerTransactionId String            @map("ledger_transaction_id") @db.Uuid
  status              WalletEntryStatus
  amount              BigInt
  createdAt           DateTime          @default(now()) @map("created_at")

  @@map("wallet_transactions")
}

model SellerBankAccount {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId               String   @map("seller_id") @db.Uuid
  bankName               String   @map("bank_name") @db.VarChar(120)
  accountHolder          String   @map("account_holder") @db.VarChar(150)
  accountNumberEncrypted Bytes    @map("account_number_encrypted")
  accountNumberLast4     String   @map("account_number_last4") @db.Char(4)
  isDefault              Boolean  @default(false) @map("is_default")
  status                 String   @default("ACTIVE")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @map("updated_at")

  @@index([sellerId, status, createdAt])
  @@map("seller_bank_accounts")
}

model Payout {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId            String       @map("seller_id") @db.Uuid
  amount              BigInt
  fee                 BigInt       @default(0)
  netAmount           BigInt       @map("net_amount")
  bankAccountId       String?      @map("bank_account_id") @db.Uuid
  ledgerTransactionId String?      @map("ledger_transaction_id") @db.Uuid
  idempotencyKey      String       @unique @map("idempotency_key")
  status              PayoutStatus @default(REQUESTED)
  requestedAt         DateTime     @default(now()) @map("requested_at")
  processedAt         DateTime?    @map("processed_at")
  failureReason       String?      @map("failure_reason")
  updatedAt           DateTime     @default(now()) @map("updated_at")

  @@index([sellerId, status, requestedAt])
  @@map("payouts")
}

model Refund {
  id                           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                      String       @map("order_id") @db.Uuid
  paymentId                    String?      @map("payment_id") @db.Uuid
  requestedBy                  String       @map("requested_by") @db.Uuid
  processedBy                  String?      @map("processed_by") @db.Uuid
  type                         RefundType
  amount                       BigInt
  currency                     String       @default("VND") @db.Char(3)
  reason                       String?
  status                       RefundStatus @default(REQUESTED)
  idempotencyKey               String       @unique @map("idempotency_key")
  originalLedgerTransactionId  String?      @map("original_ledger_transaction_id") @db.Uuid
  reversingLedgerTransactionId String?      @map("reversing_ledger_transaction_id") @db.Uuid
  requestedAt                  DateTime     @default(now()) @map("requested_at")
  processedAt                  DateTime?    @map("processed_at")
  updatedAt                    DateTime     @default(now()) @map("updated_at")

  @@index([orderId, status, requestedAt])
  @@index([requestedBy, requestedAt])
  @@map("refunds")
}

// A replaceable, derived daily reporting projection. Source-of-truth remains
// the append-only ledger, orders and refunds; this table only makes dashboard
// and export queries fast without weakening financial auditability.
model PlatformRevenue {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revenueDate           DateTime @map("revenue_date") @db.Date
  currency              String   @default("VND") @db.Char(3)
  totalOrders           Int      @default(0) @map("total_orders")
  gmv                   BigInt   @default(0)
  platformFee           BigInt   @default(0) @map("platform_fee")
  paymentProcessingCost BigInt   @default(0) @map("payment_processing_cost")
  sellerPayout          BigInt   @default(0) @map("seller_payout")
  promotionRevenue      BigInt   @default(0) @map("promotion_revenue")
  subscriptionRevenue   BigInt   @default(0) @map("subscription_revenue")
  advertisingRevenue    BigInt   @default(0) @map("advertising_revenue")
  shippingMargin        BigInt   @default(0) @map("shipping_margin")
  refundVolume          BigInt   @default(0) @map("refund_volume")
  netRevenue            BigInt   @default(0) @map("net_revenue")
  refreshedAt           DateTime @default(now()) @map("refreshed_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @map("updated_at")

  @@unique([revenueDate, currency])
  @@index([currency, revenueDate])
  @@map("platform_revenues")
}

model IdempotencyKey {
  key         String   @id
  actorId     String?  @map("actor_id") @db.Uuid
  requestHash String   @map("request_hash")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  @@map("idempotency_keys")
}

model FinancialAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@map("financial_audit_logs")
}

model ContentReport {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String    @map("reporter_id") @db.Uuid
  reportedUserId String?   @map("reported_user_id") @db.Uuid
  productId      String?   @map("product_id") @db.Uuid
  reason         String    @db.VarChar(80)
  details        String?   @db.VarChar(1000)
  status         String    @default("OPEN") @db.VarChar(20)
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at")
  resolutionNote String?   @map("resolution_note") @db.VarChar(1000)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("content_reports")
}

model ModerationAuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  oldStatus String   @map("old_status") @db.VarChar(20)
  newStatus String   @map("new_status") @db.VarChar(20)
  note      String?  @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([reportId, createdAt])
  @@map("moderation_audit_logs")
}
