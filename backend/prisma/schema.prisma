model shipments {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id       String          @unique @db.Uuid
  carrier        String?         @db.VarChar(50)
  tracking_code  String?         @db.VarChar(100)
  sender_name    String?         @db.VarChar(150)
  sender_phone   String?         @db.VarChar(20)
  receiver_name  String?         @db.VarChar(150)
  receiver_phone String?         @db.VarChar(20)
  shipping_fee   Decimal         @default(0) @db.Decimal(15, 2)
  status         shipment_status @default(PENDING)
  picked_up_at   DateTime?       @db.Timestamptz(6)
  delivered_at   DateTime?       @db.Timestamptz(6)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)

  @@index([status], map: "idx_shipments_status")
  @@index([tracking_code], map: "idx_shipments_tracking")
}

