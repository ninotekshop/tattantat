generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PricingRule {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String          @unique
  kind      PricingRuleKind
  currency  String          @default("VND") @db.Char(3)
  status    String
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("pricing_rules")
}

model PricingVersion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId        String    @map("rule_id") @db.Uuid
  rateBps       Int       @map("rate_bps")
  fixedAmount   BigInt    @default(0) @map("fixed_amount")
  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  reason        String
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([ruleId, effectiveFrom], map: "pricing_versions_active_range")
  @@map("pricing_versions")
}

model PromotionPackage {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String         @unique
  name          String
  price         BigInt
  durationHours Int            @map("duration_hours")
  promotionType promotion_type @map("promotion_type")
  status        String         @default("ACTIVE")
  effectiveFrom DateTime       @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime?      @map("effective_to") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @db.Timestamptz(6)

  @@map("promotion_packages")
}

model PromotionPackageVersion {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId     String         @map("package_id") @db.Uuid
  price         BigInt
  durationHours Int            @map("duration_hours")
  promotionType promotion_type @map("promotion_type")
  status        String         @default("ACTIVE")
  effectiveFrom DateTime       @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime?      @map("effective_to") @db.Timestamptz(6)
  createdBy     String?        @map("created_by") @db.Uuid
  reason        String
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([packageId, status, effectiveFrom(sort: Desc)], map: "promotion_package_versions_active_idx")
  @@map("promotion_package_versions")
}

model PromotionOrder {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId              String         @map("seller_id") @db.Uuid
  productId             String         @map("product_id") @db.Uuid
  packageId             String         @map("package_id") @db.Uuid
  packagePriceSnapshot  BigInt         @map("package_price_snapshot")
  status                String         @default("PENDING")
  idempotencyKey        String?        @unique @map("idempotency_key")
  paidAt                DateTime?      @map("paid_at") @db.Timestamptz(6)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  packageVersionId      String         @map("package_version_id") @db.Uuid
  durationHoursSnapshot Int            @map("duration_hours_snapshot")
  promotionTypeSnapshot promotion_type @map("promotion_type_snapshot")

  @@index([sellerId, createdAt(sort: Desc)], map: "promotion_orders_seller_idx")
  @@index([packageVersionId], map: "promotion_orders_version_idx")
  @@map("promotion_orders")
}

model SubscriptionPlan {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String    @unique
  name          String
  price         BigInt
  billingCycle  String    @map("billing_cycle")
  maxListings   Int?      @map("max_listings")
  features      Json      @default("[]")
  status        String    @default("ACTIVE")
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("subscription_plans")
}

model SubscriptionPlanVersion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId        String    @map("plan_id") @db.Uuid
  price         BigInt
  billingCycle  String    @map("billing_cycle")
  maxListings   Int?      @map("max_listings")
  features      Json      @default("[]")
  status        String    @default("ACTIVE")
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  reason        String
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([planId, status, effectiveFrom(sort: Desc)], map: "subscription_plan_versions_active_idx")
  @@map("subscription_plan_versions")
}

model Subscription {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId             String    @map("seller_id") @db.Uuid
  planId               String    @map("plan_id") @db.Uuid
  priceSnapshot        BigInt    @map("price_snapshot")
  status               String    @default("ACTIVE")
  startsAt             DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt               DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  planVersionId        String    @map("plan_version_id") @db.Uuid
  billingCycleSnapshot String    @map("billing_cycle_snapshot")
  maxListingsSnapshot  Int?      @map("max_listings_snapshot")
  featuresSnapshot     Json      @default("[]") @map("features_snapshot")

  @@index([sellerId, status, endsAt], map: "subscriptions_seller_active_idx")
  @@index([planVersionId], map: "subscriptions_version_idx")
  @@map("subscriptions")
}

model SubscriptionOrder {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId             String    @map("seller_id") @db.Uuid
  planId               String    @map("plan_id") @db.Uuid
  priceSnapshot        BigInt    @map("price_snapshot")
  status               String    @default("PENDING")
  idempotencyKey       String    @unique @map("idempotency_key")
  ledgerTransactionId  String?   @map("ledger_transaction_id") @db.Uuid
  subscriptionId       String?   @map("subscription_id") @db.Uuid
  paidAt               DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  planVersionId        String    @map("plan_version_id") @db.Uuid
  billingCycleSnapshot String    @map("billing_cycle_snapshot")
  maxListingsSnapshot  Int?      @map("max_listings_snapshot")
  featuresSnapshot     Json      @default("[]") @map("features_snapshot")

  @@index([sellerId, status, createdAt(sort: Desc)], map: "subscription_orders_seller_status_idx")
  @@index([planVersionId], map: "subscription_orders_version_idx")
  @@map("subscription_orders")
}

model AdvertisingCampaign {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId            String    @map("seller_id") @db.Uuid
  productId           String?   @map("product_id") @db.Uuid
  campaignType        String    @map("campaign_type")
  pricingModel        String    @default("FIXED_PRICE") @map("pricing_model")
  budget              BigInt
  spent               BigInt    @default(0)
  status              String    @default("DRAFT")
  startAt             DateTime? @map("start_at") @db.Timestamptz(6)
  endAt               DateTime? @map("end_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  ledgerTransactionId String?   @map("ledger_transaction_id") @db.Uuid
  paidAt              DateTime? @map("paid_at") @db.Timestamptz(6)

  @@index([sellerId, status], map: "advertising_campaigns_seller_idx")
  @@map("advertising_campaigns")
}

model ShippingTransaction {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId             String    @unique @map("order_id") @db.Uuid
  customerFee         BigInt    @map("customer_fee")
  providerCost        BigInt    @map("provider_cost")
  platformMargin      BigInt    @map("platform_margin")
  status              String    @default("PENDING")
  ledgerTransactionId String?   @map("ledger_transaction_id") @db.Uuid
  settledBy           String?   @map("settled_by") @db.Uuid
  settledAt           DateTime? @map("settled_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)], map: "shipping_transactions_status_idx")
  @@map("shipping_transactions")
}

model LedgerTransaction {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           LedgerTransactionType
  orderId        String?               @map("order_id") @db.Uuid
  paymentId      String?               @map("payment_id") @db.Uuid
  referenceId    String?               @map("reference_id") @db.Uuid
  idempotencyKey String?               @unique @map("idempotency_key")
  status         String
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  finalizedAt    DateTime?             @map("finalized_at") @db.Timestamptz(6)

  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  accountCode   String   @map("account_code")
  amount        BigInt
  currency      String   @default("VND") @db.Char(3)
  userId        String?  @map("user_id") @db.Uuid
  orderId       String?  @map("order_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId], map: "ledger_entries_order_idx")
  @@index([transactionId], map: "ledger_entries_transaction_idx")
  @@map("ledger_entries")
}

model SellerWallet {
  sellerId         String   @id @map("seller_id") @db.Uuid
  pendingBalance   BigInt   @default(0) @map("pending_balance")
  availableBalance BigInt   @default(0) @map("available_balance")
  heldBalance      BigInt   @default(0) @map("held_balance")
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("seller_wallets")
}

model WalletTransaction {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId            String            @map("seller_id") @db.Uuid
  orderId             String?           @map("order_id") @db.Uuid
  ledgerTransactionId String            @map("ledger_transaction_id") @db.Uuid
  status              WalletEntryStatus
  amount              BigInt
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("wallet_transactions")
}

model SellerBankAccount {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId               String   @map("seller_id") @db.Uuid
  bankName               String   @map("bank_name") @db.VarChar(120)
  accountHolder          String   @map("account_holder") @db.VarChar(150)
  accountNumberEncrypted Bytes    @map("account_number_encrypted")
  accountNumberLast4     String   @map("account_number_last4") @db.Char(4)
  isDefault              Boolean  @default(false) @map("is_default")
  status                 String   @default("ACTIVE") @db.VarChar(20)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([sellerId, status, createdAt(sort: Desc)], map: "seller_bank_accounts_seller_idx")
  @@map("seller_bank_accounts")
}

model Payout {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId            String       @map("seller_id") @db.Uuid
  amount              BigInt
  fee                 BigInt       @default(0)
  netAmount           BigInt       @map("net_amount")
  idempotencyKey      String       @unique @map("idempotency_key")
  status              PayoutStatus @default(REQUESTED)
  requestedAt         DateTime     @default(now()) @map("requested_at") @db.Timestamptz(6)
  processedAt         DateTime?    @map("processed_at") @db.Timestamptz(6)
  bankAccountId       String?      @map("bank_account_id") @db.Uuid
  ledgerTransactionId String?      @map("ledger_transaction_id") @db.Uuid
  failureReason       String?      @map("failure_reason")
  updatedAt           DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([sellerId, status, requestedAt(sort: Desc)], map: "payouts_seller_status_idx")
  @@map("payouts")
}

model Refund {
  id                           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                      String       @map("order_id") @db.Uuid
  paymentId                    String?      @map("payment_id") @db.Uuid
  requestedBy                  String       @map("requested_by") @db.Uuid
  processedBy                  String?      @map("processed_by") @db.Uuid
  type                         RefundType
  amount                       BigInt
  currency                     String       @default("VND") @db.Char(3)
  reason                       String?
  status                       RefundStatus @default(REQUESTED)
  idempotencyKey               String       @unique @map("idempotency_key")
  originalLedgerTransactionId  String?      @map("original_ledger_transaction_id") @db.Uuid
  reversingLedgerTransactionId String?      @map("reversing_ledger_transaction_id") @db.Uuid
  requestedAt                  DateTime     @default(now()) @map("requested_at") @db.Timestamptz(6)
  processedAt                  DateTime?    @map("processed_at") @db.Timestamptz(6)
  updatedAt                    DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([orderId, status, requestedAt(sort: Desc)], map: "refunds_order_status_idx")
  @@index([requestedBy, requestedAt(sort: Desc)], map: "refunds_requested_by_idx")
  @@map("refunds")
}

model PlatformRevenue {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revenueDate           DateTime @map("revenue_date") @db.Date
  currency              String   @default("VND") @db.Char(3)
  totalOrders           Int      @default(0) @map("total_orders")
  gmv                   BigInt   @default(0)
  platformFee           BigInt   @default(0) @map("platform_fee")
  paymentProcessingCost BigInt   @default(0) @map("payment_processing_cost")
  sellerPayout          BigInt   @default(0) @map("seller_payout")
  promotionRevenue      BigInt   @default(0) @map("promotion_revenue")
  subscriptionRevenue   BigInt   @default(0) @map("subscription_revenue")
  advertisingRevenue    BigInt   @default(0) @map("advertising_revenue")
  shippingMargin        BigInt   @default(0) @map("shipping_margin")
  refundVolume          BigInt   @default(0) @map("refund_volume")
  netRevenue            BigInt   @default(0) @map("net_revenue")
  refreshedAt           DateTime @default(now()) @map("refreshed_at") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([revenueDate, currency], map: "platform_revenues_date_currency_unique")
  @@index([currency, revenueDate(sort: Desc)], map: "platform_revenues_currency_date_idx")
  @@map("platform_revenues")
}

model IdempotencyKey {
  key         String   @id
  actorId     String?  @map("actor_id") @db.Uuid
  requestHash String   @map("request_hash")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("idempotency_keys")
}

model FinancialAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt(sort: Desc)], map: "financial_audit_logs_entity_idx")
  @@map("financial_audit_logs")
}

model ContentReport {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String    @map("reporter_id") @db.Uuid
  reportedUserId String?   @map("reported_user_id") @db.Uuid
  productId      String?   @map("product_id") @db.Uuid
  reason         String    @db.VarChar(80)
  details        String?   @db.VarChar(1000)
  status         String    @default("OPEN") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  resolutionNote String?   @map("resolution_note") @db.VarChar(1000)

  @@index([status, createdAt(sort: Desc)], map: "content_reports_status_idx")
  @@map("content_reports")
}

model ModerationAuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  oldStatus String   @map("old_status") @db.VarChar(20)
  newStatus String   @map("new_status") @db.VarChar(20)
  note      String?  @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([reportId, createdAt(sort: Desc)], map: "moderation_audit_logs_report_idx")
  @@map("moderation_audit_logs")
}

