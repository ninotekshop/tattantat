NODE_ENV=development
PORT=3000
## Comma-separated browser origins permitted to call the API. Add the web app in development.
CORS_ORIGINS=http://localhost:3001
API_PREFIX=api/v1
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tattantat
JWT_ACCESS_SECRET=replace-with-a-32-byte-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-byte-secret
# Required before creating seller bank accounts. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BANK_ACCOUNT_ENCRYPTION_KEY=
DEV_OTP_CODE=123456
CORS_ORIGINS=http://localhost:3000
# Set false only for one-off jobs/tests. Multiple API instances are safe: a
# PostgreSQL advisory lock ensures only one instance expires promotions each run.
FINANCIAL_MAINTENANCE_ENABLED=true
PROMOTION_EXPIRY_INTERVAL_MS=900000
REVENUE_REPORT_REFRESH_INTERVAL_MS=3600000
COMMERCIAL_LIFECYCLE_INTERVAL_MS=900000

# Nhắc quản trị viên khi tin chờ duyệt tồn đọng (mặc định bật, kiểm tra mỗi 10 phút)
MODERATION_REMINDER_ENABLED=true
MODERATION_REMINDER_INTERVAL_MS=600000
# Nhắc người bán khi gói sắp hết hạn (mặc định bật, kiểm tra mỗi giờ)
BILLING_EXPIRY_REMINDER=true
BILLING_EXPIRY_INTERVAL_MS=3600000

