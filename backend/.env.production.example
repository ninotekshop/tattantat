# ====== backend/.env trên HOSTINGER (sao chép thành backend/.env rồi điền giá trị thật) ======
NODE_ENV=production
# Hostinger tự cấp PORT; không cần khai báo nếu hPanel đã đặt.
API_PREFIX=api/v1

# --- Tên miền (BẮT BUỘC dùng https) ---
PUBLIC_WEB_URL=https://TENMIEN-CUA-BAN.vn
CORS_ORIGINS=https://TENMIEN-CUA-BAN.vn,https://www.TENMIEN-CUA-BAN.vn

# --- Cơ sở dữ liệu Supabase: dùng "Session pooler" (Connect > Session pooler), KHÔNG dùng db.xxx.supabase.co (chỉ IPv6, Hostinger thường không kết nối được) ---
DATABASE_URL=postgresql://postgres.zebyboumthiqnlcnnxnr:MATKHAU@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_POOL_MAX=10
SUPABASE_URL=https://zebyboumthiqnlcnnxnr.supabase.co
SUPABASE_SECRET_KEY=

# --- Bảo mật (mỗi khóa tối thiểu 32 ký tự ngẫu nhiên, KHÁC nhau) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BANK_ACCOUNT_ENCRYPTION_KEY=

# --- Thanh toán ---
PAYMENT_GATEWAY=payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# --- Email / SMS / AI / cảnh báo (nên có) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tất Tần Tật <cskh@ninotekpos.com>"
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
ANTHROPIC_API_KEY=
ALERT_WEBHOOK_URL=

# KHÔNG đặt DEV_OTP_CODE trên máy chủ thật.

# Đăng nhập OTP qua Firebase: khóa riêng của project web (tùy chọn)
FIREBASE_AUTH_SERVICE_ACCOUNT_PATH=
